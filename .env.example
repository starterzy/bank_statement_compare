# 数据库直连配置样例 —— 复制为 .env 并填入真实值（.env 已被 gitignore）
ORACLE_HOST=10.8.190.61
ORACLE_PORT=1521
ORACLE_SERVICE=ZNKGNCC
ORACLE_USER=nccread_zy
ORACLE_PASSWORD=your_password
# Oracle 11g 需要 thick 模式 + Instant Client，填 oci.dll 所在目录（留空则自动从 PATH 找）
ORACLE_LIB_DIR=D:\oracle\instantclient_23_6

# 银行流水查询口径：账簿 + 科目定位「银行存款」，DB_ORG 用于列出该公司银行账户
DB_ACCOUNTING_BOOK=1001A11000000000F1XL
DB_PK_ACCASOA=1001A11000000000ENQP
DB_ORG=0001A110000000001I2D
DB_YEAR=2026
DB_PERIOD_FROM=01
DB_PERIOD_TO=12

# LLM 字段识别（模型见 app/config.py；不同模型用不同的 key）
LLM_API_KEY=your_deepseek_key
# 通义千问（阿里云百炼 OpenAI 兼容接口 /compatible-mode/v1）
QWEN_API_KEY=your_qwen_key
